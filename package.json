{
  "name": "linan-tourism-platform",
  "version": "0.0.0",
  "private": true,
  "description": "临安旅游集散中心数字化系统",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "repo:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-repository.ps1",
    "repo:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-repository.ps1",
    "test:acceptance:core": "node scripts/require-core-acceptance-env.mjs && corepack pnpm --filter @linan/api test:e2e && corepack pnpm --filter @linan/admin test:e2e && corepack pnpm --filter @linan/miniapp test && corepack pnpm --filter @linan/miniapp build:mp-weixin",
    "test:release-gate": "node scripts/release-gate.mjs",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm -r --if-present test:e2e",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
