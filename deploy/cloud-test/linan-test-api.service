[Unit]
Description=Linan platform protected test API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/linan-test/app/apps/api
EnvironmentFile=/etc/linan-test/api.env
ExecStart=/opt/node-v22.23.2-linux-x64/bin/node dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
