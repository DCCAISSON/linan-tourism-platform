# Branding. Replace after the demand side confirms the official name.
APP_DISPLAY_NAME=待确认的小程序名称
APP_ENV=development

# API and database
API_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://linan:change-me@127.0.0.1:3306/linan_platform
# Generate with 32 random bytes, then base64 encode. Keep real values outside Git.
PERSON_DATA_ENCRYPTION_KEY_BASE64=
REVISION=local

# WeChat Mini Program. Keep real values only in an ignored .env file or secret manager.
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=

# Set true only after the formal subscription templates are configured. The server obtains the
# WeChat token with the AppID/AppSecret above; keep both real values outside Git.
WECHAT_SUBSCRIBE_ENABLED=false

# At least 32 characters, kept only in the secret manager. Used to HMAC phone, source, and SMS-code digests.
PHONE_AUTH_HMAC_KEY=

# Tencent Cloud SMS. The verification template must accept code and expiry minutes.
TENCENT_CLOUD_SMS_APP_ID=
TENCENT_CLOUD_SMS_SIGN_NAME=
TENCENT_CLOUD_SMS_TEMPLATE_ID=

# One-time production administrator bootstrap. Keep both values outside Git.
PRODUCTION_ADMIN_OPENID=
PRODUCTION_ADMIN_BOOTSTRAP_TOKEN=

# WeChat Pay
WECHAT_PAY_ENABLED=false
WECHAT_REFUND_ENABLED=false
WECHAT_PAY_MERCHANT_MODE=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=

# Tencent Cloud
TENCENT_CLOUD_REGION=ap-shanghai
TENCENT_CLOUD_COS_BUCKET=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
