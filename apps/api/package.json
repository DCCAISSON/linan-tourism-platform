{
  "name": "@linan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:check": "node scripts/check-database-url.mjs",
    "db:migrate": "corepack pnpm --filter @linan/contracts build && corepack pnpm build && node scripts/domain-database.mjs migrate",
    "db:revert": "corepack pnpm --filter @linan/contracts build && corepack pnpm build && node scripts/domain-database.mjs revert",
    "db:seed:test": "corepack pnpm --filter @linan/contracts build && corepack pnpm build && node scripts/seed-domain-test.mjs",
    "dev": "corepack pnpm db:check && nest start --watch",
    "lint": "oxlint src/ test/ scripts/",
    "start": "corepack pnpm db:check && nest start",
    "start:prod": "corepack pnpm db:check && node dist/main.js",
    "test": "vitest run",
    "test:e2e": "corepack pnpm --filter @linan/contracts build && vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "corepack pnpm --filter @linan/contracts build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@linan/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "mysql2": "^3.24.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.18.6",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
