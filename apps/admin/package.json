  },
  "dependencies": {
    "element-plus": "2.11.5",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "@vitejs/plugin-vue": "6.0.1",
    "jsdom": "30.0.1",
    "oxlint": "^1.58.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "5.0.0",
    "vue-tsc": "3.1.2"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  }
}
