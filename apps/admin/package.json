{
  "name": "@linan/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "oxlint src/ tests/ e2e/ vite.config.ts playwright.config.ts vitest.config.ts",
    "typecheck": "vue-tsc --noEmit",
